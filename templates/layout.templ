package templates

templ Layout(title string, nav templ.Component, content templ.Component) {
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <title>{ title }</title>
        <script src="/static/htmx.min.js"></script>
        <script src="/static/tailwind.js"></script>
        <style>
            .bg-library {
                background-image: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)), 
                                  url('https://images.unsplash.com/photo-1507842217343-583bb7270b66?q=80&w=2000');
                background-size: cover;
                background-position: center;
            }
            .accent-green { color: #4ade80; }
            .bg-accent-green { background-color: #4ade80; }
        </style>
    </head>
    // layout.templ
    <body class="flex h-screen bg-gray-100">
    if nav != nil {
        <aside class="w-64 bg-slate-900 text-white flex flex-col">
            <div class="p-6 border-b border-slate-800">
                <h1 class="text-2xl font-bold accent-green">LMS PRO</h1>
            </div>
            @nav
        </aside>
    }

    <main class="flex-1 flex flex-col overflow-hidden">
        if nav != nil {
            <header class="bg-white shadow-sm p-4 flex justify-between items-center">
                <h2 class="text-xl font-semibold text-gray-700">{ title }</h2>
                <button hx-post="/logout" class="text-sm text-red-500 hover:underline">Logout</button>
            </header>
        }
        <div class="flex-1 overflow-y-auto">
            @content
        </div>
    </main>
    </body>
    </html>
}
