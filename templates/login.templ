package templates

templ LoginPage() {
    <div class="h-screen w-screen flex items-center justify-center bg-library relative">
        <div class="absolute inset-0 bg-black/50 backdrop-blur-sm z-0"></div>
        
        <div class="relative z-10 w-full max-w-md bg-white p-10 rounded-2xl shadow-2xl">
            <div class="text-center mb-8">
                <h2 class="text-3xl font-extrabold text-slate-900">Welcome Back</h2>
                <p class="text-green-500 font-medium">Please enter your library credentials</p>
            </div>
            
            <form hx-post="/login" hx-target="#login-err" class="space-y-6">
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Email Address</label>
                    <input type="email" name="email" 
                           class="w-full px-4 py-3 border border-slate-200 rounded-lg text-slate-900 focus:ring-2 focus:ring-green-400 outline-none bg-white" 
                           required />
                </div>
                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-2">Password</label>
                    <input type="password" name="password" 
                           class="w-full px-4 py-3 border border-slate-200 rounded-lg text-slate-900 focus:ring-2 focus:ring-green-400 outline-none bg-white" 
                           required />
                </div>
                <div id="login-err" class="text-red-500 text-sm italic"></div>
                <button type="submit" class="w-full bg-green-400 text-slate-900 font-bold py-3 rounded-lg hover:bg-green-500 transition-all">
                    LOGIN TO ACCOUNT
                </button>
            </form>
        </div>
    </div>
}
